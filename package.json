{
  "name": "@k0tarak/swagger-search-ai",
  "version": "0.1.1",
  "description": "Configurable search for Swagger UI with an optional OpenRouter AI assistant",
  "license": "MIT",
  "keywords": [
    "swagger",
    "swagger-ui",
    "openapi",
    "api-documentation",
    "search",
    "full-text-search",
    "openrouter",
    "ai-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k0tarak/swagger-search-ai.git"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "publishConfig": { "access": "public" },
  "bugs": { "url": "https://github.com/k0tarak/swagger-search-ai/issues" },
  "homepage": "https://github.com/k0tarak/swagger-search-ai#readme",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./standalone": {
      "import": { "types": "./dist/standalone.d.mts", "default": "./dist/standalone.mjs" },
      "require": { "types": "./dist/standalone.d.cts", "default": "./dist/standalone.cjs" }
    },
    "./plugin.js": "./dist/plugin.js",
    "./standalone.js": "./dist/standalone.js",
    "./plugin.css": "./dist/plugin.css",
    "./standalone.css": "./dist/standalone.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "fixtures"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "evaluate": "npm run build && node scripts/audit-search.cjs",
    "benchmark": "npm run build && node scripts/benchmark.cjs",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check",
    "check": "npm test && npm run test:package"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "marked": "15.0.12",
    "minisearch": "7.2.0",
    "swagger-ui-dist": "5.33.0",
    "typescript": "5.9.3"
  }
}
